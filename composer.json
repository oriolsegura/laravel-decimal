{
    "name": "oriolsegura/laravel-decimal",
    "description": "Value Object to handle decimals in Laravel without losing precision and directly from Eloquent models.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "laravel",
        "decimal",
        "precision",
        "eloquent",
        "cast",
        "value-object",
        "money"
    ],
    "authors": [
        {
            "name": "Oriol Segura",
            "email": "oriol.segura.nino@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-bcmath": "*",
        "illuminate/contracts": "^11.0 || ^12.0 || ^13.0",
        "illuminate/database": "^11.0 || ^12.0 || ^13.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "orchestra/testbench": "^9.0 || ^10.0 || ^11.0",
        "laravel/pint": "^1.29",
        "infection/infection": "0.32.6"
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-f": "vendor/bin/phpunit --filter",
        "test-c": "vendor/bin/phpunit --coverage-text",
        "test-i": "vendor/bin/infection --ansi",
        "format": "vendor/bin/pint --ansi"
    },
    "autoload": {
        "psr-4": {
            "OriolSegura\\Decimal\\": "src/"
        },
        "files": [
            "helpers/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "OriolSegura\\Decimal\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "infection/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
